# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by server actions to write validated progress. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used for auth email links). e.g. https://sankofa-chess.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" once Google is configured in Supabase → Authentication → Providers
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Optional: live AI coach (server-side only). Leave empty to use the built-in guided coach.
AI_API_KEY=
# Optional model override for the live coach
AI_MODEL=
